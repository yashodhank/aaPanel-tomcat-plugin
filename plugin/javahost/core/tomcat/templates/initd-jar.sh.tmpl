#!/bin/bash -p
### BEGIN INIT INFO
# Provides:          javahost-@@app@@
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: JavaHost executable-JAR app @@app@@
### END INIT INFO
# Rendered by JavaHost — init.d fallback for executable-JAR apps on hosts
# without systemd. Single env source: @@app_dir@@/bin/app.env.
export JAVA_HOME="@@java_home@@"
export SERVER_PORT="@@port@@"
APP_DIR="@@app_dir@@"
PIDFILE="$APP_DIR/app.pid"
RUNAS="@@user@@"
JAR="$APP_DIR/app.jar"
JAVA_OPTS="@@java_opts@@"
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH
unset LD_PRELOAD BASH_ENV ENV CDPATH GLOBIGNORE

start() {
  # Drop privileges before parsing app.env. Valid shell-identifier application
  # variables are accepted, except service controls and parser internals; RUNAS,
  # JAVA_HOME, APP_DIR, JAR, JAVA_OPTS and PIDFILE remain trusted rendered values.
  # Values are decoded literally, never shell-sourced or evaluated.
  /usr/bin/env -i PATH="$PATH" JAVA_HOME="$JAVA_HOME" \
    SERVER_PORT="$SERVER_PORT" APP_DIR="$APP_DIR" PIDFILE="$PIDFILE" \
    JAR="$JAR" JAVA_OPTS="$JAVA_OPTS" \
    /usr/sbin/runuser -u "$RUNAS" -- /bin/bash -c '
      decode_env_value() {
        local __input="$1" __output="" __char="" __next=""
        while [ -n "$__input" ]; do
          __char="${__input:0:1}"
          __input="${__input:1}"
          if [[ "$__char" == "\\" && -n "$__input" ]]; then
            __next="${__input:0:1}"
            if [[ "$__next" == "\\" || "$__next" == "\"" ]]; then
              __char="$__next"
              __input="${__input:1}"
            fi
          fi
          __output+="$__char"
        done
        printf "%s" "$__output"
      }
      if [ -f "$APP_DIR/bin/app.env" ]; then
        while IFS="=" read -r __k __v; do
          case "$__k" in
            ""|[0-9]*|*[!A-Za-z0-9_]*|RUNAS|JAVA_HOME|APP_DIR|JAR|JAVA_OPTS|PIDFILE|IFS|BASH_ENV|ENV|SHELLOPTS|BASHOPTS|__*)
              continue
              ;;
          esac
          case "$__v" in
            \"*\") __v="${__v#\"}"; __v="${__v%\"}" ;;
          esac
          __v="$(decode_env_value "$__v")"
          export "$__k=$__v"
        done < "$APP_DIR/bin/app.env"
      fi
      cd "$APP_DIR" || exit 1
      "$JAVA_HOME/bin/java" $JAVA_OPTS -jar "$JAR" >> "$APP_DIR/logs/app.out" 2>&1 &
      echo $! > "$PIDFILE"
    '
}

read_pid() {
  [ -f "$PIDFILE" ] || return 1
  __pid="$(/bin/cat "$PIDFILE")"
  case "$__pid" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s\n' "$__pid"
}

stop() {
  if __pid="$(read_pid)"; then
    # app.pid is service-user writable. Signal as that same account so a
    # forged PID can never make this root init script kill another user's job.
    /usr/bin/env -i PATH="$PATH" /usr/sbin/runuser -u "$RUNAS" -- \
      /bin/kill -- "$__pid" 2>/dev/null || true
  fi
  /usr/bin/env -i PATH="$PATH" /usr/sbin/runuser -u "$RUNAS" -- \
    /bin/rm -f -- "$PIDFILE"
}

status() {
  __pid="$(read_pid)" || { echo stopped; return 3; }
  /usr/bin/env -i PATH="$PATH" /usr/sbin/runuser -u "$RUNAS" -- \
    /bin/kill -0 -- "$__pid" 2>/dev/null \
    && echo running || { echo stopped; return 3; }
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) "$0" stop; /bin/sleep 2; "$0" start ;;
  status)  status ;;
  *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
