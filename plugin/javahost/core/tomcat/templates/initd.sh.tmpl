#!/bin/bash
### BEGIN INIT INFO
# Provides:          javahost-@@app@@
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: JavaHost Tomcat instance @@app@@
### END INIT INFO
# Rendered by JavaHost — fallback for hosts without systemd. setenv.sh inside
# CATALINA_BASE/bin is the primary env; bin/app.env carries DB_* (and related)
# and is loaded line-by-line below — NEVER shell-sourced (`. app.env` would
# re-evaluate $(...)/backticks in a password as root).
export JAVA_HOME="@@java_home@@"
export CATALINA_HOME="@@catalina_home@@"
export CATALINA_BASE="@@catalina_base@@"
export CATALINA_PID="@@catalina_base@@/temp/tomcat.pid"
RUNAS="@@user@@"

# Load app.env WITHOUT shell-sourcing it: `. file` would expand $(...)/backticks
# in values (e.g. a DB password), enabling command injection. Read line-by-line
# and export literally instead — `export "$k=$v"` does not re-evaluate $v.
load_app_env() {
  if [ -f "$CATALINA_BASE/bin/app.env" ]; then
    while IFS='=' read -r __k __v; do
      case "$__k" in ''|\#*) continue ;; esac
      __v="${__v%\"}"; __v="${__v#\"}"
      export "$__k=$__v"
    done < "$CATALINA_BASE/bin/app.env"
  fi
}

# Use runuser (not the aaPanel-jailed `su`) to drop privileges.
run() { runuser -u "$RUNAS" -- bash -c "$1"; }
case "$1" in
  start)   load_app_env; run "$CATALINA_HOME/bin/catalina.sh start" ;;
  stop)    run "$CATALINA_HOME/bin/catalina.sh stop" ;;
  restart) run "$CATALINA_HOME/bin/catalina.sh stop"; sleep 2; load_app_env; run "$CATALINA_HOME/bin/catalina.sh start" ;;
  status)  [ -f "$CATALINA_PID" ] && kill -0 "$(cat "$CATALINA_PID")" 2>/dev/null && echo running || { echo stopped; exit 3; } ;;
  *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
